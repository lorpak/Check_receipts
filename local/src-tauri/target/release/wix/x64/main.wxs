<?if $(sys.BUILDARCH)="x86"?>
    <?define Win64 = "no" ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?elseif $(sys.BUILDARCH)="x64"?>
    <?define Win64 = "yes" ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?elseif $(sys.BUILDARCH)="arm64"?>
    <?define Win64 = "yes" ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else?>
    <?error Unsupported value of sys.BUILDARCH=$(sys.BUILDARCH)?>
<?endif?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product
            Id="*"
            Name="CheckReceipts"
            UpgradeCode="12a908bd-2676-5d95-a63b-1074ffacc046"
            Language="!(loc.TauriLanguage)"
            Manufacturer="check"
            Version="0.1.0">

        <Package Id="*"
                 Keywords="Installer"
                 InstallerVersion="450"
                 Languages="0"
                 Compressed="yes"
                 InstallScope="perMachine"
                 SummaryCodepage="!(loc.TauriCodepage)"/>

        <!-- https://docs.microsoft.com/en-us/windows/win32/msi/reinstallmode -->
        <!-- reinstall all files; rewrite all registry entries; reinstall all shortcuts -->
        <Property Id="REINSTALLMODE" Value="amus" />

        <!-- Auto launch app after installation, useful for passive mode which usually used in updates -->
        <Property Id="AUTOLAUNCHAPP" Secure="yes" />
        <!-- Property to forward cli args to the launched app to not lose those of the pre-update instance -->
        <Property Id="LAUNCHAPPARGS" Secure="yes" />

            <MajorUpgrade Schedule="afterInstallInitialize" AllowDowngrades="yes" />

        <InstallExecuteSequence>
            <RemoveShortcuts>Installed AND NOT UPGRADINGPRODUCTCODE</RemoveShortcuts>
        </InstallExecuteSequence>

        <Media Id="1" Cabinet="app.cab" EmbedCab="yes" />


        <Icon Id="ProductIcon" SourceFile="C:\Users\Я\Desktop\Check_receipts\local\src-tauri\target\release\resources\icon.ico"/>
        <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
        <Property Id="ARPNOREPAIR" Value="yes" Secure="yes" />      <!-- Remove repair -->
        <SetProperty Id="ARPNOMODIFY" Value="1" After="InstallValidate" Sequence="execute"/>

        <!-- initialize with previous InstallDir -->
        <Property Id="INSTALLDIR">
            <RegistrySearch Id="PrevInstallDirReg" Root="HKCU" Key="Software\check\CheckReceipts" Name="InstallDir" Type="raw"/>
        </Property>

        <!-- launch app checkbox -->
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="!(loc.LaunchApp)" />
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1"/>
        <CustomAction Id="LaunchApplication" Impersonate="yes" FileKey="Path" ExeCommand="[LAUNCHAPPARGS]" Return="asyncNoWait" />

        <UI>
            <!-- launch app checkbox -->
            <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>

            <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />

            <!-- Skip license dialog -->
            <Publish Dialog="WelcomeDlg"
                     Control="Next"
                     Event="NewDialog"
                     Value="InstallDirDlg"
                     Order="2">1</Publish>
            <Publish Dialog="InstallDirDlg"
                     Control="Back"
                     Event="NewDialog"
                     Value="WelcomeDlg"
                     Order="2">1</Publish>
        </UI>

        <UIRef Id="WixUI_InstallDir" />

        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="DesktopFolder" Name="Desktop">
                <Component Id="ApplicationShortcutDesktop" Guid="*">
                    <Shortcut Id="ApplicationDesktopShortcut" Name="CheckReceipts" Description="Runs CheckReceipts" Target="[!Path]" WorkingDirectory="INSTALLDIR" />
                    <RemoveFolder Id="DesktopFolder" On="uninstall" />
                    <RegistryValue Root="HKCU" Key="Software\check\CheckReceipts" Name="Desktop Shortcut" Type="integer" Value="1" KeyPath="yes" />
                </Component>
            </Directory>
            <Directory Id="$(var.PlatformProgramFilesFolder)" Name="PFiles">
                <Directory Id="INSTALLDIR" Name="CheckReceipts"/>
            </Directory>
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="CheckReceipts"/>
            </Directory>
        </Directory>

        <DirectoryRef Id="INSTALLDIR">
            <Component Id="RegistryEntries" Guid="*">
                <RegistryKey Root="HKCU" Key="Software\check\CheckReceipts">
                    <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLDIR]" KeyPath="yes" />
                </RegistryKey>
            </Component>
            <Component Id="Path" Guid="5186107b-f35a-58c2-bc55-994124597e80" Win64="$(var.Win64)">
                <File Id="Path" Source="C:\Users\Я\Desktop\Check_receipts\local\src-tauri\target\release\CheckReceipts.exe" KeyPath="yes" Checksum="yes"/>
            </Component>
            <Directory Id="If6acf5b68f9943fe818d68d33a87e6b1" Name="_up_"><Component Id="Iece57989e55b4a1bb1a4f5b35cac64d9" Guid="5d6c65f9-e6ab-43a6-9c7d-ab5987db84b4" Win64="$(var.Win64)" KeyPath="yes"><File Id="PathFile_Iece57989e55b4a1bb1a4f5b35cac64d9" Source="C:\Users\Я\Desktop\Check_receipts\local\src-tauri\..\app.py" /></Component><Component Id="Ia0cb0cde2c044b3bad7165c3767bb647" Guid="9080a2a3-c31e-4cb1-a129-37da5191a20c" Win64="$(var.Win64)" KeyPath="yes"><File Id="PathFile_Ia0cb0cde2c044b3bad7165c3767bb647" Source="C:\Users\Я\Desktop\Check_receipts\local\src-tauri\..\check_receipts.py" /></Component><Directory Id="I457caf5f31ec4756ab083147c60e1c15" Name="resources"><Directory Id="I1136c1c750c445b7971cd34ee6a805a4" Name="python"><Directory Id="Ief3353fe839646c3a48963c7b3906f80" Name="Lib"><Directory Id="I6c1c008efaf7495ea7fead6ceecc61ea" Name="site-packages"><Component Id="I18d50db8ff4048ac905f8c97c57c7765" Guid="d39b0a3b-db38-4e2d-9f45-bc7a0e225f6d" Win64="$(var.Win64)" KeyPath="yes"><File Id="PathFile_I18d50db8ff4048ac905f8c97c57c7765" Source="C:\Users\Я\Desktop\Check_receipts\local\src-tauri\..\resources\python\Lib\site-packages\six.py" /></Component><Directory Id="Ifad7510d658449b1b8b48749ea626755" Name="dateutil"><Component Id="I71f771b961074aad90f435c869f973c7" Guid="4d77d261-1491-4178-be4a-a4e488618ea9" Win64="$(var.Win64)" KeyPath="yes"><File Id="PathFile_I71f771b961074aad90f435c869f973c7" Source="C:\Users\Я\Desktop\Check_receipts\local\src-tauri\..\resources\python\Lib\site-packages\dateutil\easter.py" /></Component><Component Id="I749cb59d623548b8bf49f092bdb56be7" Guid="7284d2ae-6baa-49ec-aadd-3b7b2160f2e5" Win64="$(var.Win64)" KeyPath="yes"><File Id="PathFile_I749cb59d623548b8bf49f092bdb56be7" Source="C:\Users\Я\Desktop\Check_receipts\local\src-tauri\..\resources\python\Lib\site-packages\dateutil\relativedelta.py" /></Component><Component Id="I0f33318499874925ba1caabe29e0019d" Guid="91a87616-5173-4135-8109-89e10fe91954" Win64="$(var.Win64)" KeyPa